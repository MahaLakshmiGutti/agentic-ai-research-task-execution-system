# Which provider the agents use: "openai" or "google". Fixed for the
# process's lifetime - change this and restart the backend to switch.
LLM_PROVIDER=openai

# OpenAI - required if LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini - optional, only needed if you want the Gemini provider available
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.1-flash-lite

# Tavily web search
TAVILY_API_KEY=your-tavily-api-key-here

# CORS - comma separated list of allowed origins for the frontend dev server
CORS_ORIGINS=http://localhost:5173

# SQLite database file path (relative to backend/)
DATABASE_PATH=data/app.db
